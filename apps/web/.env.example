# Teu Marketing · variáveis de ambiente do apps/web
# Produção: cadastrar estas chaves no painel da Vercel (Settings → Environment Variables).
# Local: copiar para apps/web/.env e usar os valores de `pnpm exec supabase status`.
# Nunca commitar valores reais. Só as variáveis NUXT_PUBLIC_* chegam ao navegador.

# URL pública do app, sem barra no fim. Base dos links do Convite e da volta do link mágico.
# Tem que estar também em Supabase → Authentication → URL Configuration (Site URL + Redirect URLs: <URL>/**).
NUXT_PUBLIC_SITE_URL=https://app.teumarketing.com.br

# Supabase → Project Settings → API Keys (região sa-east-1)
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_<chave>
# Secreta: só no servidor (aceitar Convite, gravar eventos). Nunca em variável NUXT_PUBLIC_*.
NUXT_SUPABASE_SECRET_KEY=sb_secret_<chave>

# Resend → API Keys (permissão: Sending access, domínio teumarketing.com.br verificado com SPF/DKIM)
NUXT_RESEND_API_KEY=re_<chave>
NUXT_EMAIL_REMETENTE="Teu Marketing <convite@teumarketing.com.br>"

# Versão gravada em cada evento de telemetria. Na Vercel: usar o SHA do commit.
NUXT_PUBLIC_VERSAO_APP=<sha-do-commit>

# Só em dev, sem Resend: emails do app vão para o Mailpit do Supabase local. Deixar vazio em produção.
NUXT_MAILPIT_URL=
